{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022", "DOM"],
    "rootDir": ".", "outDir": "dist", "strict": true, "skipLibCheck": true, "declaration": false,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "harness/**/*.ts", "tests/**/*.ts", "scratch/**/*.ts"]
}
